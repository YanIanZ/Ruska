{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YanIanZ/Ruska/blob/docs/ruksa-hackathon-blueprint/schemas/behavior-genome.schema.json",
  "title": "RUKSA RELIC Behavior Genome",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "states",
    "rules",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "const": "relic-genome-v1"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "observed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "observed": {
            "type": "boolean"
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string",
            "maxLength": 500
          },
          "status": {
            "enum": [
              "OBSERVED",
              "INFERRED",
              "DISPROVED",
              "UNKNOWN"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    }
  },
  "description": "Trusted control plane must additionally verify OBSERVED rules have actual authorized trace IDs and a valid state graph."
}
